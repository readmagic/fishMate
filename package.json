    "dayjs": "^1.11.13",
    "electron-screenshots": "^0.6.2",
    "openai": "^6.15.0",
    "pinia": "^3.0.0",
    "simple-mind-map": "^0.14.0-fix.2",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
